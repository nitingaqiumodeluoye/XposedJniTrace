<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 在SDCard中创建与删除文件权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE"/>
    <uses-permission android:name="android.permission.BROADCAST_PACKAGE_REMOVED"/>
    <!-- 往SDCard写入数据权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_LOGS"/>


    <application
        android:name="com.zhenxi.jnitrace.App"
        android:icon="@drawable/iocn"
        android:label="FunJni"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning,HardcodedDebugMode">


        <!--
            这里故意不再声明任何 xposed* meta-data。

            模块身份完全由 META-INF/xposed/ 下的 marker 文件承载(module.prop /
            java_init.list / native_init.list),Vector daemon 的 MODERN 策略读的就是这些
            (FileSystem.loadModule:targetApiVersion>=101 -> MODERN),与 manifest 无关。

            而这些 meta-data 反而是纯暴露面:安全扫描器只要 getInstalledApplications(
            GET_META_DATA) 扫一遍 manifest 的键名就能命中(xposedmodule / xposedminversion /
            xposedsharedprefs / xposedscope / xposeddescription),不需要任何运行时证据,
            属于 "包级残留" 级别的弱信号 —— DuckDetector 的 LSPosed 卡片就是这么报的。

            删掉后的行为变化:
              1) Vector 的 LegacyDelegateImpl.hookNewXSP() 依赖 xposedminversion>92 或
                 xposedsharedprefs 才会给目标进程装 ContextImpl.getPreferencesDir()
                 重定向钩子,所以那条共享 prefs 路径会失效;
              2) XSharedPreferences 会退回读 /data/data/<模块包名>/shared_prefs/config.xml,
                 目标进程没有该 uid 的读权限。
            兜底是 root cp(MainListViewAdapter.initConfig):配置一直被复制到目标 App 私有
            目录下的 FunJniConfig,而 LHook 的二次尝试读的就是它。有 root 时功能不变;
            无 root 时共享 prefs 路径失效,模块在目标进程里读不到配置。
        -->



        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".view.Xiaomiquan" />
    </application>

</manifest>
